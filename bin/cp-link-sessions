#!/bin/bash
# cp-link-sessions — make sessions from other Claude profiles visible in ~/.claude, as hard links.
#
# Why: Orca's "continue with chat UI" looks for a session's history only in ~/.claude/projects, and
# it does not accept a symlink there. A hard link is a second name for the same file: Orca sees an
# ordinary file, and Claude's appends in the other profile show up under both names (Claude appends
# to transcripts in place). bin/cp-router treats such a mirror as belonging to the other profile and
# resumes the session there. Nothing is moved, copied or edited.
#
#   cp-link-sessions --hook            Claude hook (Stop / SessionStart): mirror this session if it
#                                      belongs to another profile. Reads the hook JSON on stdin.
#   cp-link-sessions --from <dir> [--days N]
#                                      mirror that profile's sessions changed in the last N days
#                                      (default 30); also turns old symlinks into hard links
#   cp-link-sessions --list            show the mirrors that exist
#   cp-link-sessions --remove          delete every mirror this tool made (the real files stay)
#
# CP_LINK_TARGET=<dir> changes the target profile (default ~/.claude). Mirrors are recorded in
# <target>/.cp-link-manifest. Log: ~/Library/Logs/cp-router.log

TARGET="${CP_LINK_TARGET:-$HOME/.claude}"
TARGET="${TARGET%/}"
MANIFEST="$TARGET/.cp-link-manifest"
LOG="$HOME/Library/Logs/cp-router.log"

log() { { mkdir -p "${LOG%/*}" && printf '%s [link] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; } 2>/dev/null; }

# Mirror one real transcript <file> into $TARGET/projects/<same folder>/. Quiet, idempotent.
link_one() {
  local src="$1" proj dst
  [ -f "$src" ] && [ ! -L "$src" ] || return 0
  case "$src" in "$TARGET"/*) return 0 ;; esac          # already in the target profile
  case "$src" in */projects/*/*.jsonl) ;; *) return 0 ;; esac
  case "$src" in */subagents/*) return 0 ;; esac
  proj="$(basename "$(dirname "$src")")"
  dst="$TARGET/projects/$proj/$(basename "$src")"
  [ "$dst" -ef "$src" ] && [ ! -L "$dst" ] && return 0    # already mirrored
  if [ -L "$dst" ]; then rm -f "$dst"                     # an old symlink mirror: replace it
  elif [ -e "$dst" ]; then return 0                       # a different real file: never touch
  fi
  mkdir -p "$TARGET/projects/$proj" && ln "$src" "$dst" || return 0
  printf '%s\t%s\n' "$dst" "$src" >>"$MANIFEST"
  log "mirrored $proj/$(basename "$src") <- ${src%%/projects/*}"
}

case "${1:-}" in
  --hook)
    # Hook JSON has "transcript_path". Never fail or slow the session.
    tp="$(/usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin).get("transcript_path",""))' 2>/dev/null)"
    [ -n "$tp" ] && link_one "$tp"
    exit 0 ;;
  --from)
    from="${2%/}"; days=30
    [ "${3:-}" = "--days" ] && days="${4:-30}"
    [ -d "$from/projects" ] || { echo "cp-link-sessions: no projects folder in $from" >&2; exit 1; }
    n=0
    while IFS= read -r -d '' f; do
      proj="$(basename "$(dirname "$f")")"; dst="$TARGET/projects/$proj/$(basename "$f")"
      { [ -L "$dst" ] || ! [ -e "$dst" ]; } && n=$((n + 1))
      link_one "$f"
    done < <(find "$from/projects" -mindepth 2 -maxdepth 2 -name '*.jsonl' -type f -mtime "-$days" -print0)
    echo "cp-link-sessions: $n mirrors made from $from (last $days days)"
    ;;
  --list)
    [ -r "$MANIFEST" ] && while IFS=$'\t' read -r dst src; do
      [ "$dst" -ef "$src" ] && [ ! -L "$dst" ] && echo "$dst = $src"
    done < "$MANIFEST" ;;
  --remove)
    n=0
    if [ -r "$MANIFEST" ]; then
      while IFS=$'\t' read -r dst src; do
        if [ "$dst" -ef "$src" ] && [ ! -L "$dst" ]; then rm -f "$dst" && n=$((n + 1)); fi
      done < "$MANIFEST"
      rm -f "$MANIFEST"
    fi
    s=$(find "$TARGET/projects" -type l 2>/dev/null | wc -l | tr -d ' ')
    find "$TARGET/projects" -type l -delete 2>/dev/null          # old symlink mirrors
    log "removed $n mirrors, $s symlinks"; echo "cp-link-sessions: removed $n mirrors and $s old symlinks (real files untouched)" ;;
  *)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
